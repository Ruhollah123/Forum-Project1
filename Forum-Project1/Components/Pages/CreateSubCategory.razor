@page "/create-subcategory"
@using Forum_Project1.Models
@using Forum_Project1.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Context
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>Create SubCategory</h3>

<EditForm style="display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 2rem;" Model="newSubCategory" OnValidSubmit="HandleSubmit">

    <div style="width: 30%;">
        <label style="font-size: 1.2rem; font-weight: bold;" class="form-label">Main Category:</label>
        <InputSelect @bind-Value="newSubCategory.CategoryId" class="form-control">
            <option value="0">-- Select SubCategory --</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </InputSelect>
    </div>

    <div style="width: 30%;">
        <label style="font-size: 1.2rem; font-weight: bold;" class="form-label">SubCategory Name:</label>
        <InputText @bind-Value="newSubCategory.Name" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>
</EditForm>

@code {
    private SubCategory newSubCategory = new SubCategory();
    private List<Category> categories = new List<Category>();

    protected override async Task OnInitializedAsync()
    {
        categories = await Context.Categories.ToListAsync();
    }

    private async Task HandleSubmit()
    {
        if (newSubCategory.CategoryId > 0 && !string.IsNullOrWhiteSpace(newSubCategory.Name))
        {
            Context.SubCategories.Add(newSubCategory);
            await Context.SaveChangesAsync();

            Navigation.NavigateTo("/");
        }
    }
}