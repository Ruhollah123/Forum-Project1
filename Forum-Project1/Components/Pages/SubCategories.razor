@page "/subcategories-page"
@page "/category/{CategoryId:int}"
@page "/category/{CategoryId:int}/sub/{SubCategoryId:int}"
@rendermode InteractiveServer
@using Forum_Project1.Models
@inject HttpClient Http


<div class="container my-4">

    <h2 class="mb-4 text-white">Subcategories</h2>
    <a href="/create-subcategory" class="btn btn-warning fw-bold mb-3">+ Create a Subcategory</a>


    @if (listOfSubcategories == null)
    {
        <div class="text-white-50">Loading subcategories...</div>
    }
    else if (!listOfSubcategories.Any())
    {
        <div class="alert alert-dark">No subcategories found.</div>
    }
    else
    {
        <div class="row g-3 mb-5">
            @foreach (var sub in listOfSubcategories)
            {
                <div class="col-md-4">
                    <div class="card bg-dark text-white border-secondary h-100 shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">@sub.Name</h5>
                            <NavLink href="@($"/threads-page/{CategoryId}/sub/{sub.Id}")" class="btn btn-outline-warning btn-sm">
                                Show Topics →
                            </NavLink>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<SubCategory> listOfSubcategories;

    [Parameter]
    public int CategoryId { get; set; }
    
    [Parameter]
    public int? SubCategoryId { get; set; }
    
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            listOfSubcategories = await Http.GetFromJsonAsync<List<SubCategory>>($"api/subcategories/category/{CategoryId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching data: {ex.Message}");
        }
    }
}